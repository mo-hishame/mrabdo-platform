<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#070b22">
<title>مستر Abdo Arafa | منصة العلوم الفلكية</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style>
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap');
:root{--bg:#040612;--panel:rgba(18,25,54,.75);--text:#f6f7ff;--muted:#c4cced;--cyan:#46e5f5;--violet:#a78bfa;--pink:#ff5d91;--lime:#c6ff70;--line:rgba(255,255,255,.12);--grad:linear-gradient(115deg,#46e5f5 0%,#a78bfa 48%,#ff5d91 100%);font-family:'Cairo',Tahoma,sans-serif}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:70px}
body{font-family:'Cairo',Tahoma,sans-serif;background:var(--bg);color:var(--text);line-height:1.8;overflow-x:hidden;cursor:none!important}
a,button,input,select{cursor:none!important}
a{color:inherit;text-decoration:none}
button,input{font:inherit}
button:focus-visible,a:focus-visible,input:focus-visible{outline:2px solid var(--cyan);outline-offset:4px}

/* خلفية النجوم والشهب المكثفة */
#bg{position:fixed;inset:0;width:100%;height:100%;z-index:-4;pointer-events:none}
.ambient{position:fixed;z-index:-3;border-radius:50%;filter:blur(100px);opacity:.2;pointer-events:none;animation:ambientFloat 18s ease-in-out infinite alternate}
.ambient-a{width:450px;height:450px;right:-130px;top:5%;background:#7452ff}
.ambient-b{width:420px;height:420px;left:-140px;bottom:0;background:#00c9ee;animation-delay:-5s}
@keyframes ambientFloat{to{transform:translate3d(55px,-45px,0) scale(1.2)}}

/* الهيدر */
.nav{position:fixed;inset:0 0 auto;z-index:50;display:flex;justify-content:space-between;align-items:center;padding:10px 5.5%;background:rgba(4,6,18,.85);border-bottom:1px solid rgba(255,255,255,.07);backdrop-filter:blur(18px)}
.logo{display:flex;align-items:center;gap:10px;font-weight:900;white-space:nowrap}
.logo b{letter-spacing:.3px}
.logo-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:11px;background:var(--grad);color:#071022;box-shadow:0 0 25px #7a6cff55}
.nav nav{display:flex;align-items:center;gap:26px;font-size:.92rem;color:#d2d8f0}
.nav nav a{transition:color .2s}
.nav nav a:hover{color:var(--cyan)}
.nav-support{padding:7px 16px;border:1px solid #a78bfa70;border-radius:30px}
.nav-tools{display:flex;align-items:center;gap:10px;flex-shrink:0}
.wallet-chip{display:flex;align-items:center;gap:9px;padding:6px 13px;border:1px solid #b7f77870;border-radius:15px;background:linear-gradient(120deg,#b7f77812,#46e5f50a);box-shadow:0 0 22px #b7f77812}
.wallet-icon{display:grid;place-items:center;width:32px;height:32px;border-radius:10px;color:#c9ff85;background:#b7f77818;font-size:1.25rem}
.wallet-chip small,.wallet-chip b{display:block;line-height:1.3}
.wallet-chip small{font-size:.64rem;color:#aebbd5}
.wallet-chip b{font-size:.92rem;color:#d5ff9e;white-space:nowrap}
.sound-toggle{display:flex;align-items:center;gap:5px;border:1px solid #8f9eff45;background:#ffffff07;color:#dfe6ff;border-radius:12px;padding:7px 10px;font-size:.78rem}

/* الهيرو بتأثيرات النيون */
.hero{position:relative;isolation:isolate;overflow:hidden;display:grid;grid-template-columns:1fr 1fr;align-items:center;padding:75px 7% 25px;background:radial-gradient(ellipse at 72% 46%,rgba(70,229,245,.15),transparent 50%),linear-gradient(180deg,#06091d 0%,#040612 80%)}
.hero::after{content:"";position:absolute;inset:8% 3% 5%;pointer-events:none;border:1px solid rgba(70,229,245,.3);border-radius:32px;box-shadow:inset 0 0 60px rgba(70,229,245,.08),0 0 45px rgba(70,229,245,.12);animation:neonHeroFrame 4s ease-in-out infinite alternate}
@keyframes neonHeroFrame{from{opacity:.4;box-shadow:inset 0 0 30px rgba(70,229,245,.05),0 0 20px rgba(70,229,245,.08)}to{opacity:.9;box-shadow:inset 0 0 80px rgba(70,229,245,.15),0 0 60px rgba(70,229,245,.25)}}

.hero-copy{z-index:2;max-width:620px}
.eyebrow{display:inline-flex;align-items:center;gap:10px;padding:6px 13px;border:1px solid #46e5f538;background:#46e5f50a;border-radius:30px;font-size:.8rem;font-weight:800;color:var(--cyan);text-transform:uppercase}
.pulse{width:7px;height:7px;background:var(--lime);border-radius:50%;box-shadow:0 0 15px var(--lime);animation:pulse 1.5s infinite}
@keyframes pulse{50%{opacity:.35;box-shadow:0 0 3px var(--lime)}}
.brand-title{display:flex;flex-direction:column;align-items:flex-start;gap:0;margin:16px 0 12px;line-height:1.12}
.brand-small{font-size:clamp(1.8rem,3.2vw,3rem);font-weight:900;color:#fff;text-shadow:0 2px 0 #6a56c9,0 5px 0 #403b89,0 12px 30px #7667ff66}
.brand-name{font-size:clamp(2.8rem,5.8vw,5.8rem);font-weight:900;letter-spacing:-2px;background:linear-gradient(120deg,#fff 5%,#9ef5ff 28%,#a89aff 58%,#ff91bd 82%,#fff);background-size:220% auto;color:transparent;background-clip:text;-webkit-background-clip:text;filter:drop-shadow(0 4px 0 #35386e) drop-shadow(0 12px 22px #6c61ff52);animation:brandShine 7s linear infinite}
@keyframes brandShine{to{background-position:220% center}}
.hero-sub{font-size:clamp(1rem,1.8vw,1.3rem);color:#c3cbe6;max-width:470px}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin:22px 0}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:12px;padding:11px 22px;border:1px solid transparent;border-radius:14px;font-weight:800;transition:transform .25s,box-shadow .25s,border-color .25s;background:none;color:var(--text)}
.btn:hover{transform:translateY(-3px)}
.btn.primary{background:var(--grad);background-size:180% auto;color:#071022;box-shadow:0 8px 32px #8b83ff35}
.btn.primary:hover{box-shadow:0 12px 38px #8b83ff70;background-position:right center}
.btn.secondary{border-color:#8d9acb55;background:#ffffff06}
.btn.secondary:hover{border-color:var(--cyan);box-shadow:0 0 25px #46e5f51a}
.hero-proof{display:flex;gap:18px;flex-wrap:wrap;color:#e2e8ff;font-size:.85rem;font-weight:700}

/* 🧬 الخلية الـ 3D المطابقة للصورة تماماً مع الموشن الجذاب */
.scene-wrap{position:relative;display:grid;place-items:center;min-width:0;perspective:1600px}
.scene{position:relative;width:min(48vw,520px);aspect-ratio:1;display:grid;place-items:center;transform-style:preserve-3d;animation:sceneFloat 8s ease-in-out infinite}
@keyframes sceneFloat{0%,100%{transform:translateY(0) rotateX(10deg)}50%{transform:translateY(-12px) rotateX(15deg)}}

.cell-canvas{position:relative;width:100%;height:100%;display:grid;place-items:center;transform-style:preserve-3d}
.cell-ring{position:absolute;border-radius:50%;border:1px solid rgba(70,229,245,.35);box-shadow:0 0 20px rgba(70,229,245,.15);animation:ringRotate linear infinite}
.ring-1{width:75%;height:75%;border-style:dashed;animation-duration:16s;transform:rotateX(70deg)}
.ring-2{width:90%;height:90%;animation-duration:22s;transform:rotateX(72deg) rotateY(20deg)}
@keyframes ringRotate{from{transform:rotateZ(0deg) rotateX(70deg)}to{transform:rotateZ(360deg) rotateX(70deg)}}

.cell-core{position:absolute;width:32%;aspect-ratio:1;border-radius:50%;background:radial-gradient(circle at 35% 35%,#ffffff,#46e5f5 55%,#0d3568 100%);box-shadow:0 0 50px #46e5f5,inset -12px -12px 25px rgba(0,0,0,.8);animation:corePulse 3s ease-in-out infinite;z-index:5}
@keyframes corePulse{50%{transform:scale(1.08);box-shadow:0 0 70px #46e5f5}}

.cell-node{position:absolute;width:14px;height:14px;border-radius:50%;background:#ff5d91;box-shadow:0 0 20px #ff5d91,inset -3px -3px 6px rgba(0,0,0,.6);animation:nodeOrbit linear infinite}
.node-1{animation-duration:5s;top:30%;left:20%}
.node-2{animation-duration:7s;bottom:25%;right:25%;background:#b7f778;box-shadow:0 0 20px #b7f778}
.node-3{animation-duration:9s;top:60%;right:15%;background:#ffd166;box-shadow:0 0 20px #ffd166}

@keyframes nodeOrbit{0%{transform:rotate(0deg) translate(110px) rotate(0deg)}100%{transform:rotate(360deg) translate(110px) rotate(-360deg)}}

.physics-engine-label{position:absolute;bottom:-4%;left:50%;transform:translateX(-50%);white-space:nowrap;color:#8ff5ff;font-size:clamp(.65rem,1.2vw,.8rem);letter-spacing:3px;text-shadow:0 0 16px rgba(70,229,245,.6);font-weight:900}

.hero-bottom{display:flex;align-items:center;gap:16px;color:#9ca8cc;font-size:.78rem;margin-top:10px;grid-column:1/-1}
.progress{height:2px;flex:1;background:#ffffff1a;overflow:hidden}.progress i{display:block;width:33.333%;height:100%;background:var(--grad);transition:width .5s}
.slide-controls{display:flex;gap:8px;direction:ltr}.slide-controls button{width:36px;height:36px;border:1px solid #9ba7ce55;border-radius:50%;background:#ffffff08;color:white;transition:.2s}
.slide-controls button:hover{background:var(--cyan);color:#081021}

/* بقية الأقسام */
.section{padding:42px 7%;position:relative}
.section-heading{text-align:center;max-width:760px;margin:0 auto 28px}
.section-heading h2,.support-section h2{font-size:clamp(1.8rem,3.8vw,2.8rem);font-weight:900;line-height:1.35;margin:8px 0}
.section-heading h2 span,.support-section h2 span{background:var(--grad);background-clip:text;-webkit-background-clip:text;color:transparent}
.section-heading p,.support-section>p{color:var(--muted)}

.subject-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;max-width:1180px;margin:auto}
.subject-card{position:relative;overflow:hidden;text-align:right;padding:26px;border-radius:24px;color:var(--text);border:1px solid var(--line);background:linear-gradient(145deg,#141d3bdb,#0d1228e8);transition:transform .25s,border-color .25s,box-shadow .25s}
.subject-card:hover{border-color:var(--subject);box-shadow:0 15px 45px color-mix(in srgb,var(--subject) 18%,transparent);transform:translateY(-5px)}
.subject-chem{--subject:#51e6f5}.subject-phys{--subject:#ff679e}.subject-sci{--subject:#b7f778}
.subject-icon{display:grid;place-items:center;width:50px;height:50px;border:1px solid color-mix(in srgb,var(--subject) 60%,transparent);border-radius:16px;font-size:1.7rem;color:var(--subject);background:color-mix(in srgb,var(--subject) 9%,transparent)}
.subject-no{position:absolute;top:28px;left:24px;font-size:.72rem;letter-spacing:1.3px;color:#7e8bad}
.subject-card h3{font-size:1.45rem;margin:18px 0 6px}
.subject-card p{color:var(--muted);font-size:.9rem}
.subject-link{display:inline-block;margin-top:15px;color:var(--subject);font-weight:800;font-size:.86rem}

.videos-section{background:linear-gradient(180deg,transparent,rgba(10,16,36,.65),transparent)}
.filters{display:flex;justify-content:center;gap:9px;flex-wrap:wrap;margin-bottom:24px}
.filters button{padding:8px 17px;border:1px solid var(--line);border-radius:30px;background:#ffffff06;color:#dce3fb;font-weight:700;transition:.2s}
.filters button:hover,.filters button.on{border-color:transparent;background:var(--grad);color:#071022}
.video-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;max-width:1180px;margin:auto}
.video-card{overflow:hidden;border:1px solid var(--line);border-radius:20px;background:var(--panel);transition:transform .25s,border-color .25s,box-shadow .25s;text-align:right}
.video-card:hover{transform:translateY(-5px);border-color:#8d8cff77;box-shadow:0 15px 35px rgba(0,0,0,.3)}
.video-thumb{position:relative;display:grid;place-items:center;aspect-ratio:16/9;overflow:hidden;background:radial-gradient(circle at 30% 25%,var(--thumb),#111a38 67%,#090e20)}
.video-thumb .thumb-icon{font-size:3.2rem;color:var(--thumb);z-index:1}
.play{position:absolute;z-index:2;display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:#f6f8ff;color:#091024;box-shadow:0 0 25px rgba(255,255,255,.35)}
.video-info{padding:15px 16px}
.video-info small{color:var(--thumb);font-weight:800}
.video-info h3{font-size:1.05rem;margin:4px 0}
.video-info p{font-size:.84rem;color:var(--muted)}
.empty-videos{grid-column:1/-1;text-align:center;padding:35px 20px;border:1px dashed #8c9acb55;border-radius:20px;color:var(--muted)}
.upload-note{display:flex;align-items:center;gap:16px;max-width:850px;margin:24px auto 0;padding:16px 20px;border:1px solid #7d83ce36;border-radius:18px;background:#ffffff04}
.upload-symbol{display:grid;place-items:center;flex:none;width:40px;height:40px;border-radius:14px;background:#8b7cff18;color:#c1b7ff;font-size:1.4rem}

/* تنسيق باقات وكورسات المنصة مع كلمة اشترك بالكورس بشكل بارز */
.package-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;max-width:1100px;margin:0 auto 40px}
.package-card{padding:26px;border:1px solid var(--line);border-radius:24px;background:linear-gradient(145deg,#161e3ff2,#0b1129f8);text-align:right;transition:.25s;position:relative;box-shadow:0 8px 30px rgba(0,0,0,.3)}
.package-card:hover,.package-card.selected{border-color:var(--pkg,#9b8bff);transform:translateY(-6px);box-shadow:0 15px 45px color-mix(in srgb,var(--pkg,#9b8bff) 22%,transparent)}
.package-card.selected::before{content:"✓ تم اختيار الكورس";position:absolute;top:16px;left:18px;font-size:.72rem;color:var(--pkg);background:color-mix(in srgb,var(--pkg) 15%,transparent);padding:3px 10px;border-radius:20px;font-weight:900;border:1px solid color-mix(in srgb,var(--pkg) 40%,transparent)}
.package-card h3{font-size:1.4rem;font-weight:900;color:#ffffff;margin-bottom:6px;text-shadow:0 2px 4px rgba(0,0,0,.5)}
.package-desc{font-size:.88rem;color:var(--muted);margin-bottom:14px;font-weight:600}
.package-price{font-size:2.4rem;font-weight:900;color:var(--pkg,#b4a6ff);line-height:1.2;margin:12px 0;text-shadow:0 0 20px color-mix(in srgb,var(--pkg) 40%,transparent)}
.package-price small{font-size:.9rem;color:#d0d7ee;font-weight:700}
.package-card ul{list-style:none;color:#f0f3ff;font-size:.9rem;font-weight:700;margin:16px 0;border-top:1px solid rgba(255,255,255,.08);padding-top:14px}
.package-card li{margin:8px 0;display:flex;align-items:center;gap:8px}
.package-card li::before{content:"✦";color:var(--pkg);font-size:.8rem}
.package-choose{display:block;text-align:center;border:1px solid color-mix(in srgb,var(--pkg,#9b8bff) 70%,transparent);padding:11px;border-radius:14px;color:#ffffff;background:color-mix(in srgb,var(--pkg,#9b8bff) 15%,transparent);font-weight:900;font-size:1rem;margin-top:20px;transition:.2s}
.package-card:hover .package-choose,.package-card.selected .package-choose{background:var(--pkg);color:#060b1e;box-shadow:0 0 25px color-mix(in srgb,var(--pkg) 50%,transparent)}

.payment-wrap{max-width:1050px;margin:auto;border-top:1px solid var(--line);padding-top:30px}
.payment-title{text-align:center;margin-bottom:20px}
.payment-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.payment-card{display:flex;align-items:center;gap:15px;padding:20px;border:1px solid var(--line);border-radius:20px;background:#ffffff05}
.payment-card.vodafone{--method:#ff5a72}.payment-card.instapay{--method:#b39bff}
.payment-icon{display:grid;place-items:center;width:50px;height:50px;border-radius:16px;background:color-mix(in srgb,var(--method) 14%,transparent);border:1px solid color-mix(in srgb,var(--method) 40%,transparent);font-size:1.5rem;font-weight:900;color:var(--method)}
.payment-link{display:inline-flex;align-items:center;justify-content:center;margin-top:8px;padding:8px 15px;border:1px solid rgba(70,229,245,.4);border-radius:12px;color:#baf8ff;background:rgba(70,229,245,.06);font-weight:800;font-size:.85rem}
.payment-summary{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap;margin-top:20px;padding:18px 20px;border:1px solid var(--line);border-radius:18px;background:#ffffff05}

.support-section{text-align:center;padding-top:34px!important;padding-bottom:22px!important;background:radial-gradient(ellipse at 50% 70%,rgba(102,87,223,.12),transparent 48%)}
.support-orb{display:grid;place-items:center;width:64px;height:64px;margin:0 auto 16px;border:1px solid rgba(156,140,255,.4);border-radius:20px;color:#c4baff;font-size:1.8rem;background:linear-gradient(135deg,rgba(156,140,255,.12),rgba(70,229,245,.05));animation:orbFloat 4s ease-in-out infinite}
@keyframes orbFloat{50%{transform:translateY(-6px)}}
.support-actions{display:flex;justify-content:center;gap:10px;flex-wrap:wrap}

footer{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:10px 7%;border-top:1px solid var(--line);color:#8d99b9;font-size:.82rem;margin:0!important}

/* مؤشر الماوس النيون الدائري */
.cursor-orbit{position:fixed;left:0;top:0;z-index:3000;pointer-events:none;opacity:0;width:34px;height:34px;box-sizing:border-box;border:2px solid #8ff5ff;border-radius:50%;background:rgba(8,13,35,.18);box-shadow:0 0 10px rgba(70,229,245,.5),0 0 20px rgba(167,139,250,.3);animation:cursorCirclePulse 2.4s ease-in-out infinite;transform:translate(-50%,-50%);transition:width .2s,height .2s,border-color .2s,opacity .2s}
.cursor-core{position:fixed;left:0;top:0;z-index:3001;pointer-events:none;opacity:0;width:5px;height:5px;border-radius:50%;background:#fff;box-shadow:0 0 8px #fff,0 0 15px var(--cyan);transform:translate(-50%,-50%);transition:opacity .2s}
.cursor-glow{position:fixed;left:0;top:0;z-index:2999;pointer-events:none;opacity:0;width:110px;height:110px;border-radius:50%;background:radial-gradient(circle,rgba(70,229,245,.12) 0%,rgba(139,92,246,.05) 34%,transparent 72%);transform:translate(-50%,-50%);transition:opacity .2s}
.cursor-visible{opacity:1!important}
.cursor-orbit.cursor-hover{width:44px;height:44px;border-color:#b7f778;box-shadow:0 0 16px rgba(183,247,120,.6)}
.cursor-orbit.cursor-click{width:26px;height:26px;border-color:#ff8fb7}
@keyframes cursorCirclePulse{0%,100%{box-shadow:0 0 10px rgba(70,229,245,.5),0 0 22px rgba(167,139,250,.2)}50%{box-shadow:0 0 15px rgba(70,229,245,.7),0 0 30px rgba(255,93,145,.35)}}

/* شات الدعم الفني العصري */
.chat-fab{position:fixed;bottom:18px;left:18px;z-index:900;width:58px;height:58px;border:1px solid rgba(255,255,255,.35);border-radius:20px;background:var(--grad);color:#071022;font-size:1.5rem;box-shadow:0 10px 30px rgba(109,99,255,.35);transition:transform .25s}
.chat-fab:hover{transform:translateY(-3px) scale(1.03)}
.chat-fab i{position:absolute;top:4px;right:4px;width:9px;height:9px;border-radius:50%;background:#b9ff76;box-shadow:0 0 10px #b9ff76}
.chat{position:fixed;bottom:84px;left:18px;z-index:901;display:flex;flex-direction:column;width:min(365px,calc(100vw - 28px));height:min(510px,calc(100dvh - 105px));border:1px solid rgba(255,255,255,.15);border-radius:23px;overflow:hidden;background:rgba(12,18,42,.97);backdrop-filter:blur(20px);box-shadow:0 25px 80px rgba(0,0,0,.6)}
.chat[hidden]{display:none!important}
.chat-head{display:flex;align-items:center;gap:10px;padding:14px;background:linear-gradient(110deg,#20264a,#151b39);border-bottom:1px solid var(--line)}
.chat-avatar{display:grid;place-items:center;width:38px;height:38px;border-radius:13px;background:var(--grad);color:#071022;font-size:1.2rem;font-weight:900}
.chat-title{flex:1}.chat-title b{display:block;font-size:.92rem}.chat-title small{display:flex;align-items:center;gap:6px;color:#9ca9ca;font-size:.74rem}
.chat-title small i{width:7px;height:7px;border-radius:50%;background:#9eff73}
.chat-head>button{background:transparent;border:0;color:white;font-size:1.5rem}
.chat-body{flex:1;overflow-y:auto;padding:14px;display:flex;flex-direction:column;gap:10px;overscroll-behavior:contain}
.message{max-width:88%;padding:10px 13px;border-radius:15px;font-size:.87rem;line-height:1.6;white-space:pre-wrap;overflow-wrap:anywhere}
.message.bot{align-self:flex-start;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.05);border-bottom-right-radius:4px}
.message.me{align-self:flex-end;background:#5addec;color:#061a2b;border-bottom-left-radius:4px}
.message a{color:inherit;text-decoration:underline;font-weight:800}
.chips{display:flex;flex-wrap:wrap;gap:6px;padding:0 12px 10px}
.chips button{padding:5px 11px;border:1px solid rgba(123,138,255,.4);border-radius:20px;background:rgba(255,255,255,.03);color:#dbe1ff;font-size:.75rem}
.chips button:hover{background:rgba(141,131,255,.15)}
.chat-in{display:flex;gap:8px;padding:10px;border-top:1px solid var(--line)}
.chat-in input{min-width:0;flex:1;padding:9px 13px;border:1px solid rgba(255,255,255,.12);border-radius:25px;background:rgba(255,255,255,.05);color:white;outline:none;font-size:15px}
.chat-in input:focus{border-color:var(--cyan)}
