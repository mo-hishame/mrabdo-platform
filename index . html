    {id:"c2",name:"اشتترك بالكورس الثانى (علوم متكاملة)",price:"180",desc:"كورس العلوم المتكاملة الشامل",color:"#b7f778",features:["شرح مبسط وتفاعل مستمر مع الطلبة","حل أسئلة وتدريبات مكثفة","امتحانات شوامل وأفكار امتحانات","متابعة مستمرة مع المستر"]},
    {id:"c3",name:"اشتترك بالكورس الثالث (كيمياء وفزياء)",price:"300",desc:"الباقة المزدوجة للكيمياء والفيزياء",color:"#ff679e",features:["شرح مبسط وتفاعل مستمر للمادتين","حل أسئلة ومسائل مكثفة جداً","امتحانات شوامل نهائية لكل فصل","أولوية قصوى في الدعم والمتابعة"]}
  ]
};

const VIDEOS = [];

(() => {
  "use strict";
  const $ = (s, p=document) => p.querySelector(s); const $$ = (s, p=document) => [...p.querySelectorAll(s)];
  const phone = CONFIG.phone.replace(/\D/g,"");
  let activeSlide = 0, selectedPackage = null, toastTimer, soundEnabled = true, audioContext = null;

  $("#year").textContent = new Date().getFullYear();
  $("#wa").href = `https://wa.me/${phone}`;
  if ($("#supportLink")) $("#supportLink").href = `https://wa.me/${phone}`;
  $("#payWa").href = `https://wa.me/${phone}?text=${encodeURIComponent("مرحبًا، أريد تأكيد دفع اشتراك الكورس بمنصة مستر Abdo Arafa.")}`;

  function toast(msg) {
    const el = $("#toast"); el.textContent = msg; el.classList.add("show");
    clearTimeout(toastTimer); toastTimer = setTimeout(() => el.classList.remove("show"), 2600);
  }

  function clickSound() {
    if (!soundEnabled) return;
    try {
      const AudioCtx = window.AudioContext || window.webkitAudioContext; if (!AudioCtx) return;
      audioContext = audioContext || new AudioCtx();
      if (audioContext.state === "suspended") audioContext.resume();
      const osc = audioContext.createOscillator(), gain = audioContext.createGain();
      osc.type = "sine"; osc.frequency.setValueAtTime(740, audioContext.currentTime);
      osc.frequency.exponentialRampToValueAtTime(390, audioContext.currentTime + 0.075);
      gain.gain.setValueAtTime(0.0001, audioContext.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.055, audioContext.currentTime + 0.008);
      gain.gain.exponentialRampToValueAtTime(0.0001, audioContext.currentTime + 0.095);
      osc.connect(gain); gain.connect(audioContext.destination); osc.start(); osc.stop(audioContext.currentTime + 0.1);
    } catch (_) {}
  }
  $("#soundToggle").addEventListener("click", () => {
    soundEnabled = !soundEnabled;
    $("#soundToggle").innerHTML = soundEnabled ? "🔊 <span>الصوت</span>" : "🔇 <span>مكتوم</span>";
    if (soundEnabled) clickSound();
  });

  /* مؤشر ماوس دائري نيون دقيق ومخصص */
  const cursorGlow = $("#cursorGlow"), cursorCore = $("#cursorCore"), cursorOrbit = $("#cursorOrbit");
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  let pointerX = -100, pointerY = -100, cursorFrame = 0;
  if (finePointer && cursorGlow && cursorCore && cursorOrbit) {
    const movePointer = e => { 
      pointerX=e.clientX; pointerY=e.clientY; 
      [cursorGlow,cursorCore,cursorOrbit].forEach(el=>el.classList.add("cursor-visible")); 
      if(!cursorFrame) cursorFrame=requestAnimationFrame(renderPointer); 
    };
    function renderPointer(){
      cursorFrame=0;
      cursorCore.style.transform=`translate3d(${pointerX}px,${pointerY}px,0) translate(-50%,-50%)`;
      cursorOrbit.style.transform=`translate3d(${pointerX}px,${pointerY}px,0) translate(-50%,-50%)`;
      cursorGlow.style.transform=`translate3d(${pointerX}px,${pointerY}px,0) translate(-50%,-50%)`;
    }
    window.addEventListener("pointermove",movePointer,{passive:true});
    document.addEventListener("pointerover",e=>{if(e.target.closest("a,button,input,select"))cursorOrbit.classList.add("cursor-hover");},{passive:true});
    document.addEventListener("pointerout",e=>{if(e.target.closest("a,button,input,select"))cursorOrbit.classList.remove("cursor-hover");},{passive:true});
    window.addEventListener("pointerdown",()=>cursorOrbit.classList.add("cursor-click"),{passive:true});
    window.addEventListener("pointerup",()=>cursorOrbit.classList.remove("cursor-click"),{passive:true});
  }

  /* خلفية النجوم المتقدمة مع تكثيف الشهب (Shooting Stars) */
  const canvas = $("#bg"), ctx = canvas.getContext("2d");
  let width=0,height=0,particles=[],meteors=[];
  function resizeCanvas() {
    width = window.innerWidth; height = window.innerHeight;
    canvas.width = width; canvas.height = height;
    particles = Array.from({length:Math.min(110, Math.floor(width*height/14000))},()=>({
      x:Math.random()*width, y:Math.random()*height,
      r:Math.random()*1.7+.3, a:Math.random()*0.8+.2,
      twinkleSpeed:Math.random()*0.025+0.005
    }));
    meteors = Array.from({length:6},()=>resetMeteor(true));
  }
  function resetMeteor(randomDelay=false){
    return {
      x:Math.random()*width + width*.3,
      y:Math.random()*(height*.5),
      length:Math.random()*100+70,
      speed:Math.random()*15+10,
      angle:Math.PI/4,
      opacity:Math.random()*0.9+0.3,
      activeTimer:randomDelay ? Math.random()*180 : Math.random()*80+20
    };
  }
  function drawBackground() {
    requestAnimationFrame(drawBackground);
    ctx.clearRect(0,0,width,height);
    
    // رسم النجوم وتوهجها
    for(let i=0;i<particles.length;i++){
      const p=particles[i];
      p.a += (Math.random()-.5)*p.twinkleSpeed;
      p.a = Math.max(0.15, Math.min(0.95, p.a));
      ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
      ctx.fillStyle=`rgba(220,235,255,${p.a})`;
      ctx.fill();
    }

    // رسم الشهب المكثفة المتحركة
    for(let i=0;i<meteors.length;i++){
      const m=meteors[i];
      if(m.activeTimer > 0){
        m.activeTimer--;
        continue;
      }
      m.x -= m.speed * Math.cos(m.angle);
      m.y += m.speed * Math.sin(m.angle);
      
      const grad = ctx.createLinearGradient(m.x, m.y, m.x + m.length * Math.cos(m.angle), m.y - m.length * Math.sin(m.angle));
      grad.addColorStop(0, `rgba(255,255,255,${m.opacity})`);
      grad.addColorStop(0.5, `rgba(70,229,245,${m.opacity*.8})`);
      grad.addColorStop(1, 'rgba(70,229,245,0)');
      
      ctx.beginPath();
      ctx.moveTo(m.x, m.y);
      ctx.lineTo(m.x + m.length * Math.cos(m.angle), m.y - m.length * Math.sin(m.angle));
      ctx.strokeStyle = grad;
      ctx.lineWidth = 2.2;
      ctx.stroke();

      if(m.x < -150 || m.y > height + 150){
        meteors[i] = resetMeteor(false);
      }
    }
  }
  resizeCanvas(); drawBackground(); window.addEventListener("resize",resizeCanvas,{passive:true});

  /* باقات وكورسات المنصة */
  function renderPackages(){
    $("#pkgs").innerHTML=CONFIG.packages.map(pkg=>`<button class="package-card" type="button" data-package="${pkg.id}" style="--pkg:${pkg.color}">
      <h3>${pkg.name}</h3><div class="package-desc">${pkg.desc}</div><div class="package-price">${pkg.price} <small>${CONFIG.currency}</small></div>
      <ul>${pkg.features.map(f=>`<li>${f}</li>`).join("")}</ul><span class="package-choose">اشترك بالكورس الآن</span>
    </button>`).join("");
    $$("[data-package]").forEach(btn=>btn.addEventListener("click",()=>{ selectedPackage=CONFIG.packages.find(p=>p.id===btn.dataset.package); $$
("[data-package]").forEach(b=>b.classList.toggle("selected",b===btn));
      $("#selName").textContent=selectedPackage.name;
      const payMessage = encodeURIComponent(`مرحبًا، أريد تفاصيل الدفع والاشتراك في ${selectedPackage.name} بسعر ${selectedPackage.price} جنيه.`);
      $("#payWa").href=`https://wa.me/${phone}?text=${payMessage}`;
      toast(`تم اختيار ${selectedPackage.name}`);
    }));
  }
  renderPackages();

  /* شات الدعم الفني */
  const chat=$("#chat"),chatBody=$("#chatBody");
  function addMessage(text,type="bot",link=null){
    const div=document.createElement("div");div.className=`message ${type}`;div.textContent=text;
    if(link){
      const a=document.createElement("a");a.href=link;a.target="_blank";a.rel="noopener";
      a.textContent="\nتواصل مع الدعم الفني على واتساب ↗";div.appendChild(a);
    }
    chatBody.appendChild(div);chatBody.scrollTop=chatBody.scrollHeight;
  }
  function openChat(){
    chat.hidden=false;
    if(!chatBody.children.length) addMessage("أهلًا بيك في منصة مستر Abdo Arafa الفلكية 👋\nأنا مساعدك الفوري، اختار الكورس المناسب أو اكتب استفسارك وسأقوم بمساعدتك.");
    $("#chatInput").focus();
  }
  function closeChat(){chat.hidden=true;}
  $("#fab").addEventListener("click",()=>chat.hidden?openChat():closeChat());
  $("#openChat").addEventListener("click",openChat);
  $("#chatX").addEventListener("click",closeChat);

  function replyTo(msg){
    let answer="وصلت رسالتك. للتواصل الفوري مع الدعم الفني وتأكيد الاشتراك في الكورس، اضغط على الرابط بالأسفل:";
    if(/دفع|فلوس|إيصال|فودافون|انستا|اشتراك|كورس/.test(msg)) answer="بخصوص اشتراكات الكورسات: يمكنك تحويل المبلغ المطلوب وإرسال صورة الإيصال للدعم لتفعيل الكورس بحسابك فوراً.";
    else if(/فيديو|درس|مشكلة/.test(msg)) answer="إذا واجهتك مشكلة في تشغيل الفيديو، يرجى إعادة تحميل الصفحة أو إرسال عنوان الدرس للدعم الفني.";
    setTimeout(()=>addMessage(answer,"bot",`https://wa.me/${phone}?text=${encodeURIComponent("مرحبًا فريق الدعم: "+msg)}`),300);
  }

  $("#chatForm").addEventListener("submit",e=>{
    e.preventDefault();
    const input=$("#chatInput"), val=input.value.trim(); if(!val) return; addMessage(val,"me"); input.value=""; replyTo(val); }); $$("#chips button").forEach(btn=>btn.addEventListener("click",()=>{
    addMessage(btn.textContent,"me"); replyTo(btn.textContent);
  }));
})();
</script>
